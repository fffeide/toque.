# Configuración opcional de entorno (Toque funciona 100% sin configurar claves en local/demo)

# Frontend
# La aplicación usa el backend real en producción; en desarrollo local podés usar "mock".
VITE_API_MODE="http"
# Compatibilidad temporal con versiones anteriores:
VITE_USE_HTTP_API="true"
# Dominio corto público para impresión de QR y NFC (ejemplo: https://toque.ar)
VITE_PUBLIC_SHORT_BASE=""
# Clave pública de Mercado Pago (opcional, solo para cobros con tarjeta en vivo)
VITE_MP_PUBLIC_KEY=""
# Clave de Google Maps (opcional, para buscador de direcciones de sucursales)
VITE_GOOGLE_MAPS_API_KEY=""

# Backend (Server-only — NUNCA exponer con prefijo VITE_)
# 1. API Key de https://api.walletwallet.dev para emisión de pases Apple Wallet (.pkpass) y Google Wallet
WALLETWALLET_API_KEY=""

# 2. Envío real de correos transaccionales y OTP vía Resend (https://resend.com)
RESEND_API_KEY=""
EMAIL_FROM="Toque <no-reply@toque.com.ar>"

# 3. Mercado Pago Checkout API (Orders API v1 — cobros en el sitio sin redirección y Webhooks)
MP_ACCESS_TOKEN=""
MP_WEBHOOK_SECRET=""

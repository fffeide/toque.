# Toque — Variables de Entorno de Ejemplo

# URL de la aplicación
APP_URL="http://localhost:3000"

# Modo de capa de datos: 'mock' (en memoria con datos demo) o 'http' (backend REST real)
VITE_API_MODE="mock"

# URL base para el backend HTTP (cuando VITE_API_MODE='http')
VITE_API_BASE_URL="http://localhost:8000/api"

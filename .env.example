# Frontend (Vite)
# Dejalo vacío para usar Firestore en tiempo real.
VITE_API_MODE="firestore"
# Dominio corto definitivo que se imprime en QR/NFC (sin barra final).
VITE_PUBLIC_SHORT_BASE=""
# Public Key de Mercado Pago para tokenización en Checkout API (Sin redirección)
VITE_MP_PUBLIC_KEY=""
# Google Maps Platform API Key para el selector de dirección
VITE_GOOGLE_MAPS_API_KEY=""

# Backend (Server-only — NUNCA exponer con prefijo VITE_)
# 1. API Key de https://api.walletwallet.dev para emisión de pases Apple Wallet (.pkpass) y Google Wallet
WALLETWALLET_API_KEY=""

# 2. Envío real de correos transaccionales y OTP vía Resend (https://resend.com)
RESEND_API_KEY=""
EMAIL_FROM="Toque <no-reply@toque.com.ar>"

# 3. Mercado Pago Checkout API (Orders API v1 — cobros en el sitio sin redirección y Webhooks)

{
  "entities": {
    "business": {
      "title": "Business",
      "description": "Comercio registrado en Toque con configuración de Hub, Club, UUID único y aislamiento por organización.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "uuid": { "type": "string", "maxLength": 64 },
        "name": { "type": "string", "maxLength": 100 },
        "ownerName": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "format": "email", "maxLength": 120 },
        "ownerUid": { "type": "string", "maxLength": 128 },
        "reviewUrl": { "type": "string", "maxLength": 300 },
        "cardThemeColor": { "type": "string", "maxLength": 32 },
        "loyaltyTitle": { "type": "string", "maxLength": 120 },
        "loyaltyReward": { "type": "string", "maxLength": 200 },
        "howToEarn": { "type": "string", "maxLength": 160 },
        "expirationPolicy": { "type": "string", "maxLength": 120 },
        "stampsRequired": { "type": "number" },
        "createdAt": { "type": "string", "maxLength": 64 },
        "scansCount": { "type": "number" },
        "reviewClicksCount": { "type": "number" }
      },
      "required": ["id", "name", "email", "createdAt"]
    },
    "cartel": {
      "title": "Cartel",
      "description": "Cartel físico inteligente con chip NFC y código QR vinculado a Caja y Hub.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "uuid": { "type": "string", "maxLength": 64 },
        "code": { "type": "string", "maxLength": 32 },
        "pin": { "type": "string", "maxLength": 16 },
        "businessId": { "type": "string", "maxLength": 64 },
        "name": { "type": "string", "maxLength": 80 },
        "role": { "type": "string", "enum": ["caja", "resena"] },
        "status": { "type": "string", "enum": ["sin_activar", "active", "inactive", "trash"] },
        "reviewUrl": { "type": "string", "maxLength": 300 },
        "mode": { "type": "string", "enum": ["direct", "hub", "direct_review", "smart_hub"] },
        "scansCount": { "type": "number" },
        "reviewClicksCount": { "type": "number" },
        "activeReceiptId": { "type": "string", "maxLength": 64 },
        "activeReceiptExpiresAt": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "activatedAt": { "type": "string", "maxLength": 64 },
        "lastScannedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "code", "name", "role", "status", "createdAt"]
    },
    "sale": {
      "title": "Sale",
      "description": "Cobro emitido en la terminal de Caja de un comercio.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "uuid": { "type": "string", "maxLength": 64 },
        "businessId": { "type": "string", "maxLength": 64 },
        "cartelId": { "type": "string", "maxLength": 64 },
        "cartelCode": { "type": "string", "maxLength": 32 },
        "cartelName": { "type": "string", "maxLength": 80 },
        "receiptId": { "type": "string", "maxLength": 64 },
        "amount": { "type": "number" },
        "currency": { "type": "string", "enum": ["ARS"] },
        "method": { "type": "string", "enum": ["mp_qr", "cash", "card_manual"] },
        "status": { "type": "string", "enum": ["pending", "paid", "cancelled", "expired"] },
        "createdAt": { "type": "string", "maxLength": 64 },
        "paidAt": { "type": "string", "maxLength": 64 },
        "cashierName": { "type": "string", "maxLength": 80 },
        "cashierEmail": { "type": "string", "maxLength": 120 }
      },
      "required": ["id", "businessId", "cartelId", "amount", "method", "status", "createdAt"]
    },
    "receipt": {
      "title": "Receipt",
      "description": "Comprobante digital de compra sincronizado en tiempo real entre Caja y Hub.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "uuid": { "type": "string", "maxLength": 64 },
        "saleId": { "type": "string", "maxLength": 64 },
        "businessId": { "type": "string", "maxLength": 64 },
        "cartelCode": { "type": "string", "maxLength": 32 },
        "status": { "type": "string", "enum": ["ready", "claimed", "expired", "cancelled"] },
        "expiresAt": { "type": "string", "maxLength": 64 },
        "businessName": { "type": "string", "maxLength": 100 },
        "total": { "type": "number" },
        "currency": { "type": "string", "enum": ["ARS"] },
        "method": { "type": "string", "enum": ["mp_qr", "cash", "card_manual"] },
        "createdAt": { "type": "string", "maxLength": 64 },
        "claimedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "saleId", "businessId", "cartelCode", "status", "total", "createdAt"]
    },
    "member": {
      "title": "ClubMember",
      "description": "Socio registrado en el Club de Fidelidad con Tarjeta de Sellos Digital y pase WalletWallet.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "uuid": { "type": "string", "maxLength": 64 },
        "businessId": { "type": "string", "maxLength": 64 },
        "name": { "type": "string", "maxLength": 80 },
        "email": { "type": "string", "maxLength": 120 },
        "phone": { "type": "string", "maxLength": 40 },
        "birthDate": { "type": "string", "maxLength": 16 },
        "contact": { "type": "string", "maxLength": 100 },
        "points": { "type": "number" },
        "stamps": { "type": "number" },
        "stampsRequired": { "type": "number" },
        "rewardsRedeemed": { "type": "number" },
        "memberCode": { "type": "string", "maxLength": 32 },
        "lastStampedAt": { "type": "string", "maxLength": 64 },
        "passId": { "type": "string", "maxLength": 80 },
        "passUrl": { "type": "string", "maxLength": 500 },
        "appleWalletUrl": { "type": "string", "maxLength": 500 },
        "googleWalletUrl": { "type": "string", "maxLength": 500 },
        "joinedAt": { "type": "string", "maxLength": 64 },
        "consent": { "type": "boolean" }
      },
      "required": ["id", "contact", "points", "joinedAt", "consent"]
    },
    "stampLog": {
      "title": "StampLog",
      "description": "Registro histórico de sellos sumados y premios canjeados por comercio.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "uuid": { "type": "string", "maxLength": 64 },
        "businessId": { "type": "string", "maxLength": 64 },
        "memberId": { "type": "string", "maxLength": 64 },
        "memberName": { "type": "string", "maxLength": 80 },
        "memberEmail": { "type": "string", "maxLength": 120 },
        "memberPhone": { "type": "string", "maxLength": 40 },
        "action": { "type": "string", "enum": ["stamp_added", "reward_redeemed"] },
        "stampsDelta": { "type": "number" },
        "createdAt": { "type": "string", "maxLength": 64 },
        "staffEmail": { "type": "string", "maxLength": 120 },
        "localName": { "type": "string", "maxLength": 80 }
      },
      "required": ["id", "businessId", "memberId", "action", "stampsDelta", "createdAt"]
    },
    "teamMember": {
      "title": "TeamMember",
      "description": "Colaborador del comercio con rol (Dueño, Encargado, Cajero) y permisos RLS asignados.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "uuid": { "type": "string", "maxLength": 64 },
        "businessId": { "type": "string", "maxLength": 64 },
        "name": { "type": "string", "maxLength": 80 },
        "email": { "type": "string", "format": "email", "maxLength": 120 },
        "role": { "type": "string", "enum": ["owner", "manager", "cashier"] },
        "assignedCartelId": { "type": "string", "maxLength": 64 },
        "assignedCartelCode": { "type": "string", "maxLength": 32 },
        "status": { "type": "string", "enum": ["active", "revoked"] },
        "addedAt": { "type": "string", "maxLength": 64 },
        "addedByEmail": { "type": "string", "maxLength": 120 }
      },
      "required": ["id", "businessId", "name", "email", "role", "status", "addedAt"]
    },
    "networkActivation": {
      "title": "NetworkActivation",
      "description": "Formato de activación de comercio en la Red Toque estilo Pasito.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "uuid": { "type": "string", "maxLength": 64 },
        "tenantId": { "type": "string", "maxLength": 64 },
        "businessId": { "type": "string", "maxLength": 64 },
        "merchantName": { "type": "string", "maxLength": 100 },
        "formatType": { "type": "string", "enum": ["cross_benefit", "tap_challenge", "map_pin", "receipt_banner"] },
        "title": { "type": "string", "maxLength": 120 },
        "discountText": { "type": "string", "maxLength": 120 },
        "terms": { "type": "string", "maxLength": 300 },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "tenantId", "formatType", "title", "discountText", "active"]
    },
    "consumerUser": {
      "title": "ConsumerUser",
      "description": "Comprador registrado en Mi Billetera Toque con UUID único y consentimientos.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "uuid": { "type": "string", "maxLength": 64 },
        "emailOrPhone": { "type": "string", "maxLength": 120 },
        "displayName": { "type": "string", "maxLength": 100 },
        "ageGroup": { "type": "string", "enum": ["teen", "adult", "all"] },
        "consentSaveReceipts": { "type": "boolean" },
        "consentMarketingNetwork": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "emailOrPhone", "createdAt"]
    },
    "consumerReceipt": {
      "title": "ConsumerReceipt",
      "description": "Comprobante o visita guardada en la Bóveda del Consumidor (Mi Toque).",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "uuid": { "type": "string", "maxLength": 64 },
        "consumerId": { "type": "string", "maxLength": 64 },
        "tenantId": { "type": "string", "maxLength": 64 },
        "merchantName": { "type": "string", "maxLength": 100 },
        "amountArs": { "type": "number" },
        "discountSavedArs": { "type": "number" },
        "category": { "type": "string", "maxLength": 64 },
        "receiptNote": { "type": "string", "maxLength": 240 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "consumerId", "merchantName", "createdAt"]
    }
  },
  "firestore": {
    "/businesses/{businessId}": {
      "schema": "business",
      "description": "Colección de comercios registrados y su configuración de Hub y Club."
    },
    "/carteles/{cartelId}": {
      "schema": "cartel",
      "description": "Colección de carteles físicos inteligentes NFC/QR."
    },
    "/sales/{saleId}": {
      "schema": "sale",
      "description": "Colección de cobros emitidos en mostrador."
    },
    "/receipts/{receiptId}": {
      "schema": "receipt",
      "description": "Colección de comprobantes digitales sincronizados en tiempo real con el Hub."
    },
    "/members/{memberId}": {
      "schema": "member",
      "description": "Colección de socios del Club de Fidelidad y pases WalletWallet."
    },
    "/stamp_logs/{logId}": {
      "schema": "stampLog",
      "description": "Historial de sellos sumados y premios canjeados por comercio."
    },
    "/team/{teamId}": {
      "schema": "teamMember",
      "description": "Colección de colaboradores y roles RLS por comercio."
    },
    "/network_activations/{activationId}": {
      "schema": "networkActivation",
      "description": "Formatos de activación en la Red Toque por comercio."
    },
    "/consumer_users/{consumerId}": {
      "schema": "consumerUser",
      "description": "Usuarios de la Bóveda del Consumidor (Mi Toque)."
    },
    "/consumer_receipts/{receiptId}": {
      "schema": "consumerReceipt",
      "description": "Comprobantes y garantías guardados por el comprador en Mi Toque."
    }
  }
}

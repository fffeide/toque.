rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidBusiness(data) {
      return data.id is string && data.id.size() <= 64
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 120;
    }

    function isValidCartel(data) {
      return data.id is string && data.id.size() <= 64
        && data.code is string && data.code.size() >= 1 && data.code.size() <= 32
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 100
        && data.role in ['caja', 'resena']
        && data.status in ['sin_activar', 'active', 'inactive', 'trash'];
    }

    function isValidSale(data) {
      return data.id is string && data.id.size() <= 64
        && data.businessId is string && data.businessId.size() <= 64
        && data.cartelId is string && data.cartelId.size() <= 64
        && data.amount is number && data.amount > 0
        && data.method in ['mp_qr', 'cash', 'card_manual']
        && data.status in ['pending', 'paid', 'cancelled', 'expired'];
    }

    function isValidReceipt(data) {
      return data.id is string && data.id.size() <= 64
        && data.saleId is string && data.saleId.size() <= 64
        && data.businessId is string && data.businessId.size() <= 64
        && data.cartelCode is string && data.cartelCode.size() <= 32
        && data.status in ['ready', 'claimed', 'expired', 'cancelled']
        && data.total is number && data.total > 0;
    }

    function isValidMember(data) {
      return data.id is string && data.id.size() <= 64
        && data.contact is string && data.contact.size() >= 3 && data.contact.size() <= 120
        && data.points is number && data.points >= 0;
    }

    function isValidTeamMember(data) {
      return data.id is string && data.id.size() <= 64
        && data.businessId is string && data.businessId.size() <= 64
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 100
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 120
        && data.role in ['owner', 'manager', 'cashier']
        && data.status in ['active', 'revoked'];
    }

    match /businesses/{businessId} {
      allow get, list: if isValidId(businessId);
      allow create, update: if isValidId(businessId) && isValidBusiness(incoming());
    }

    match /carteles/{cartelId} {
      allow get, list: if isValidId(cartelId);
      allow create, update: if isValidId(cartelId) && isValidCartel(incoming());
    }

    match /sales/{saleId} {
      allow get, list: if isValidId(saleId);
      allow create, update: if isValidId(saleId) && isValidSale(incoming());
    }

    match /receipts/{receiptId} {
      allow get, list: if isValidId(receiptId);
      allow create, update: if isValidId(receiptId) && isValidReceipt(incoming());
    }

    match /members/{memberId} {
      allow get, list: if isValidId(memberId);
      allow create, update: if isValidId(memberId) && isValidMember(incoming());
      allow delete: if isValidId(memberId);
    }

    match /team/{teamId} {
      allow get, list: if isValidId(teamId);
      allow create, update: if isValidId(teamId) && isValidTeamMember(incoming());
      allow delete: if isValidId(teamId);
    }

    match /system/{docId} {
      allow get, list: if isValidId(docId);
    }

    match /test/{docId} {
      allow get, list: if isValidId(docId);
    }
  }
}

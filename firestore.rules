rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Carteles públicos y de negocio
    match /carteles/{cartelId} {
      allow read: if true;
      allow create, update: if request.resource.data.name is string 
                            && request.resource.data.destinationUrl is string
                            && request.resource.data.shortCode is string;
      allow delete: if request.auth != null;
    }

    // Escaneos y telemetría de redirección
    match /scans/{scanId} {
      allow read: if true;
      allow create: if request.resource.data.shortCode is string;
      allow update, delete: if request.auth != null;
    }

    // Negocios / Tenants
    match /tenants/{tenantId} {
      allow read: if true;
      allow write: if true;
    }

    // Sistema y comprobación de conexión
    match /system/{docId} {
      allow read, write: if true;
    }
  }
}

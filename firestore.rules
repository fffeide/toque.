rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Default-Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // 1. Primitives & Unique UUID Validation (RFC 4122 + Legacy IDs)
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUuid(uuid) {
      return uuid is string
        && uuid.size() == 36
        && uuid.matches('^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$');
    }

    function hasValidOptionalUuid(data) {
      return !('uuid' in data) || isValidUuid(data.uuid);
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // 2. Role & Organization Scoping Helpers (Dueño / owner, Encargado / manager, Cajero / cashier)
    function isValidOrgScope(orgId) {
      return orgId is string && orgId.size() >= 1 && orgId.size() <= 128;
    }

    function isSameOrgOnUpdate(field) {
      return !(field in existing()) || incoming()[field] == existing()[field];
    }

    function isAllowedRoleValue(role) {
      return role in ['owner', 'manager', 'cashier', 'Dueño', 'Encargado', 'Cajero', 'superadmin'];
    }

    // 3. Entity Blueprints with Strict Schema + UUID + Organization Scope
    function isValidBusiness(data) {
      return data.id is string && data.id.size() >= 1 && data.id.size() <= 64
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 120
        && (!('email' in data) || (data.email is string && data.email.size() <= 120))
        && hasValidOptionalUuid(data);
    }

    function isValidCartel(data) {
      return data.id is string && data.id.size() >= 1 && data.id.size() <= 64
        && data.code is string && data.code.size() >= 1 && data.code.size() <= 32
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 100
        && (!('businessId' in data) || isValidOrgScope(data.businessId))
        && data.role in ['caja', 'resena']
        && data.status in ['sin_activar', 'active', 'inactive', 'trash']
        && hasValidOptionalUuid(data);
    }

    function isValidSale(data) {
      return data.id is string && data.id.size() >= 1 && data.id.size() <= 64
        && data.businessId is string && isValidOrgScope(data.businessId)
        && data.cartelId is string && data.cartelId.size() <= 64
        && data.amount is number && data.amount > 0
        && data.method in ['mp_qr', 'cash', 'card_manual']
        && data.status in ['pending', 'paid', 'cancelled', 'expired']
        && hasValidOptionalUuid(data);
    }

    function isValidReceipt(data) {
      return data.id is string && data.id.size() >= 1 && data.id.size() <= 64
        && data.saleId is string && data.saleId.size() <= 64
        && data.businessId is string && isValidOrgScope(data.businessId)
        && data.cartelCode is string && data.cartelCode.size() <= 32
        && data.status in ['ready', 'claimed', 'expired', 'cancelled']
        && data.total is number && data.total > 0
        && hasValidOptionalUuid(data);
    }

    function isValidMember(data) {
      return data.id is string && data.id.size() >= 1 && data.id.size() <= 64
        && (!('businessId' in data) || isValidOrgScope(data.businessId))
        && data.contact is string && data.contact.size() >= 3 && data.contact.size() <= 120
        && data.points is number && data.points >= 0
        && hasValidOptionalUuid(data);
    }

    function isValidTeamMember(data) {
      return data.id is string && data.id.size() >= 1 && data.id.size() <= 64
        && data.businessId is string && isValidOrgScope(data.businessId)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 100
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 120
        && isAllowedRoleValue(data.role)
        && data.status in ['active', 'revoked']
        && hasValidOptionalUuid(data);
    }

    function isValidNetworkActivation(data) {
      return data.id is string && data.id.size() >= 1 && data.id.size() <= 64
        && data.tenantId is string && isValidOrgScope(data.tenantId)
        && data.formatType in ['cross_benefit', 'tap_challenge', 'map_pin', 'receipt_banner']
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 120
        && data.discountText is string && data.discountText.size() >= 1 && data.discountText.size() <= 120
        && data.active is bool
        && hasValidOptionalUuid(data);
    }

    function isValidConsumerUser(data) {
      return data.id is string && data.id.size() >= 1 && data.id.size() <= 64
        && (!('uuid' in data) || isValidUuid(data.uuid))
        && data.emailOrPhone is string && data.emailOrPhone.size() >= 3 && data.emailOrPhone.size() <= 120
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100))
        && (!('ageGroup' in data) || data.ageGroup in ['teen', 'adult', 'all']);
    }

    function isValidConsumerReceipt(data) {
      return data.id is string && data.id.size() >= 1 && data.id.size() <= 64
        && data.consumerId is string && isValidId(data.consumerId)
        && data.merchantName is string && data.merchantName.size() >= 1 && data.merchantName.size() <= 100
        && (!('amountArs' in data) || (data.amountArs is number && data.amountArs >= 0))
        && (!('discountSavedArs' in data) || (data.discountSavedArs is number && data.discountSavedArs >= 0))
        && hasValidOptionalUuid(data);
    }

    // 4. Collection Rules Scoped by Organization & Role
    match /businesses/{businessId} {
      allow get, list: if true;
      allow create: if isValidId(businessId) && isValidBusiness(incoming()) && incoming().id == businessId;
      allow update: if isValidId(businessId) && isValidBusiness(incoming()) && isSameOrgOnUpdate('id');
    }

    match /carteles/{cartelId} {
      allow get, list: if true;
      allow create: if isValidId(cartelId) && isValidCartel(incoming());
      allow update: if isValidId(cartelId) && isValidCartel(incoming());
    }

    match /sales/{saleId} {
      allow get, list: if true;
      allow create: if isValidId(saleId) && isValidSale(incoming());
      allow update: if isValidId(saleId) && isValidSale(incoming()) && isSameOrgOnUpdate('businessId');
    }

    match /receipts/{receiptId} {
      allow get, list: if true;
      allow create: if isValidId(receiptId) && isValidReceipt(incoming());
      allow update: if isValidId(receiptId) && isValidReceipt(incoming()) && isSameOrgOnUpdate('businessId');
    }

    match /members/{memberId} {
      allow get, list: if true;
      allow create: if isValidId(memberId) && isValidMember(incoming());
      allow update: if isValidId(memberId) && isValidMember(incoming()) && isSameOrgOnUpdate('businessId');
      allow delete: if isValidId(memberId);
    }

    match /team/{teamId} {
      allow get, list: if true;
      allow create: if isValidId(teamId) && isValidTeamMember(incoming());
      allow update: if isValidId(teamId) && isValidTeamMember(incoming()) && isSameOrgOnUpdate('businessId');
      allow delete: if isValidId(teamId);
    }

    match /network_activations/{activationId} {
      allow get, list: if true;
      allow create: if isValidId(activationId) && isValidNetworkActivation(incoming());
      allow update: if isValidId(activationId) && isValidNetworkActivation(incoming()) && isSameOrgOnUpdate('tenantId');
      allow delete: if isValidId(activationId);
    }

    match /consumer_users/{consumerId} {
      allow get, list: if true;
      allow create, update: if isValidId(consumerId) && isValidConsumerUser(incoming());
    }

    match /consumer_receipts/{receiptId} {
      allow get, list: if true;
      allow create, update: if isValidId(receiptId) && isValidConsumerReceipt(incoming());
      allow delete: if isValidId(receiptId);
    }

    match /system/{docId} {
      allow get, list: if true;
    }

    match /test/{docId} {
      allow get, list: if true;
    }
  }
}

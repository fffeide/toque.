{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "toque",
  "main": "worker/index.ts",
  "compatibility_date": "2025-03-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // El Worker responde primero en estas rutas (si no, el SPA las intercepta).
    "run_worker_first": ["/r/*", "/api/*", "/healthz"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "toque-db", "database_id": "51302a78-af9a-4b3d-963d-7a410dbad463", "migrations_dir": "migrations" }
  ],
  "kv_namespaces": [
    { "binding": "KV", "id": "801398c54de749248b084536b64d3b4a" }
  ],
  "triggers": { "crons": ["0 6 1 * *"] },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    }
  }
}
